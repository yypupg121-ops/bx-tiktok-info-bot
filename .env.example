# لا ترفع ملف .env أو رمز البوت إلى GitHub
BOT_TOKEN=ضع_رمز_البوت_هنا
REQUIRED_CHANNEL=@bxcode
CHANNEL_URL=https://t.me/bxcode
# عنوان HTTPS العام للخدمة نفسها على VibeNest (خادم البوت يقدّم Mini App على /)
MINI_APP_URL=https://bx-tiktok-info-bot-2.vibenest.net/
# VibeNest يمرر PORT تلقائياً؛ قيمة التطوير المحلي الافتراضية 8000
PORT=8000
TIKTOK_API_URL=https://tiktokinfov10.itfreeforever.workers.dev
DATABASE_PATH=bx_tiktok.sqlite3
LOG_LEVEL=INFO
